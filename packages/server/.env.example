# Hearth server configuration (copy to .env and edit).

# HTTP listener
PORT=8080
HOST=0.0.0.0

# Data storage. DB_PATH defaults to ${DATA_DIR}/hearth.sqlite.
# Screenshot/capture files are stored under ${DATA_DIR}/captures.
DATA_DIR=./data
# DB_PATH=./data/hearth.sqlite

# Auth. JWT_SECRET is REQUIRED in production; a dev fallback is used (with a loud
# warning) when unset. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Token lifetime (jsonwebtoken expiresIn syntax: 12h, 7d, 3600, ...)
JWT_TTL=12h

# Screenshot retention (days) and default capture interval pushed to agents.
SCREENSHOT_RETENTION_DAYS=14
SCREENSHOT_INTERVAL_SEC=120

# Email notifications (optional). SMTP_URL is a nodemailer connection URL, e.g.
# smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM="Hearth <alerts@example.com>"

# Telegram notifications (optional). Create a bot via @BotFather and get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS: the origin of the parent dashboard SPA.
DASHBOARD_ORIGIN=http://localhost:5173

# Optional: path to a JSON file that overrides/extends the built-in content-analysis
# term lists. Shape: { "terms": [ { "term": "...", "category": "adult", "weight": 3,
# "lang": "vi" }, ... ], "domains": { "adult": ["example.com"], ... } }
ANALYSIS_TERMS_FILE=
